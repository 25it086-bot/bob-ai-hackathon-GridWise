APP_ENV=development
APP_NAME=GridWise
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
DATA_DIR=../data
DATA_SOURCE=json
RESCORE_ON_STARTUP=true
RISK_CRITICAL_THRESHOLD=80.0
RISK_HIGH_THRESHOLD=60.0
RISK_MEDIUM_THRESHOLD=40.0
OUTAGE_HIGH_PROBABILITY_THRESHOLD=0.60
MAINTENANCE_GAP_ALERT_DAYS=180
LOAD_ALERT_THRESHOLD_PCT=85.0
TEMPERATURE_ALERT_THRESHOLD_C=75.0
RATE_LIMIT_PER_MINUTE=60
SIMULATOR_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
